# ============================================================================
# TELEGRAM RSS BOT - ENVIRONMENT VARIABLES
# ============================================================================
# Copy this file to .env and fill in your values
# Then use: source .env  (or export commands on each line)

# Required Settings
export TELEGRAM_TOKEN="your_bot_token_here"
export CHAT_ID="@yourchannel"

# RSS Feed (optional, defaults to 24.hu)
export RSS_URL="https://24.hu/feed/"

# Translation Settings
export TRANSLATOR_TYPE="google"  # google, deepl, openai, anthropic, libretranslate, mymemory
export SOURCE_LANGUAGE="hu"
export TARGET_LANGUAGE="ru"

# API Keys (only for paid translators)
export DEEPL_API_KEY="your-deepl-key-here"
export OPENAI_API_KEY="your-openai-key-here"
export OPENAI_MODEL="gpt-4o-mini"
export ANTHROPIC_API_KEY="your-anthropic-key-here"
export ANTHROPIC_MODEL="claude-3-5-haiku-20241022"

# Advanced Settings
export CHECK_INTERVAL="300"
export MAX_DESCRIPTION_LENGTH="500"
export MAX_CONTENT_LENGTH="3000"
export LOG_LEVEL="INFO"
export LIBRETRANSLATE_API_URL="https://libretranslate.com/translate"

# ============================================================================
# AUTO-DELETION SETTINGS (NEW!)
# ============================================================================

# Delete messages older than N hours (0 or empty = disabled)
# Example: Delete messages older than 48 hours
export DELETE_AFTER_HOURS="48"

# Keep only N most recent messages (0 or empty = unlimited)
# Example: Keep only 100 most recent messages
export MAX_MESSAGES_TO_KEEP="100"

# You can use both settings together:
# - DELETE_AFTER_HOURS: Time-based cleanup
# - MAX_MESSAGES_TO_KEEP: Count-based cleanup
# The bot will delete messages that meet EITHER condition
